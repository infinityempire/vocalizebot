# =============================================================================
# VocalizeBot - Environment Variables Template
# =============================================================================
# 📱 For Termux Setup Instructions
# Copy this file to .env and fill in your actual values:
#   cp .env.example .env
# Then edit: nano .env
#
# ⚠️ NEVER commit your actual .env file to version control!

# =============================================================================
# 🤖 APPLICATION SETTINGS
# =============================================================================

APP_NAME="VocalizeBot"
APP_VERSION="2.0.0"
DEBUG=false
LOG_LEVEL=INFO

# =============================================================================
# 📡 TELEGRAM BOT CONFIGURATION (REQUIRED)
# =============================================================================
# How to get your Telegram Bot Token:
# 1. Open Telegram and search for @BotFather
# 2. Send /newbot
# 3. Follow the prompts to create your bot
# 4. Copy the token shown (format: 123456789:ABCdefGHIjklMNOpqrsTUVwxyz)
#
# In Termux, set this by running:
#   echo 'TELEGRAM_BOT_TOKEN=123456789:ABCdefGHIjklMNOpqrsTUVwxyz' >> .env

TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here

# Secret for webhook verification (generate a random string)
# Example: openssl rand -hex 16
TELEGRAM_WEBHOOK_SECRET=your_random_secret_here

# Allow bot in groups? Set to 'true' to enable group functionality
TELEGRAM_ALLOW_GROUPS=false

# Admin's Telegram Chat ID - receives hot lead notifications
# Get your ID by messaging @userinfobot on Telegram
TELEGRAM_ADMIN_CHAT_ID=your_admin_chat_id_here

# =============================================================================
# 🎙️ GOOGLE AI / GEMINI API (REQUIRED FOR TRANSCRIPTION)
# =============================================================================
# How to get your Google AI API Key:
# 1. Go to: https://aistudio.google.com/app/apikey
# 2. Click "Create API Key"
# 3. Copy the generated key
#
# In Termux:
#   echo 'GOOGLE_AI_API_KEY=AIza...' >> .env

GOOGLE_AI_API_KEY=your_google_genai_api_key_here

# AI Model to use (gemini-1.5-flash recommended for speed)
# Options: gemini-1.5-flash, gemini-1.5-pro, gemini-2.0-flash
DEFAULT_AI_PROVIDER=google
AI_MODEL=gemini-1.5-flash

# Alternative AI providers (optional)
# OPENAI_API_KEY=your_openai_key_here
# ANTHROPIC_API_KEY=your_anthropic_key_here

# =============================================================================
# 💳 PAYPAL PAYMENT CONFIGURATION
# =============================================================================
# How to get PayPal credentials:
# 1. Go to: https://developer.paypal.com/
# 2. Create a sandbox app or go live
# 3. Copy Client ID and Secret from your app settings
#
# In Termux:
#   echo 'PAYPAL_CLIENT_ID=your_sandbox_client_id' >> .env
#   echo 'PAYPAL_CLIENT_SECRET=your_sandbox_secret' >> .env

# Sandbox mode (for testing)
PAYPAL_MODE=sandbox
PAYPAL_CLIENT_ID=your_paypal_sandbox_client_id_here
PAYPAL_CLIENT_SECRET=your_paypal_sandbox_secret_here

# Production mode (uncomment when ready to go live)
# PAYPAL_MODE=live
# PAYPAL_CLIENT_ID=your_paypal_live_client_id_here
# PAYPAL_CLIENT_SECRET=your_paypal_live_secret_here

# PayPal Webhook ID (from PayPal dashboard -> My Apps -> Webhooks)
PAYPAL_WEBHOOK_ID=your_paypal_webhook_id_here

# =============================================================================
# 🏠 ADMIN DASHBOARD TOKEN
# =============================================================================
# This token is used to secure the Admin Dashboard API endpoints
# Generate a secure random token:
#   python3 -c "import secrets; print(secrets.token_urlsafe(32))"
#
# In Termux:
#   echo 'ADMIN_DASHBOARD_TOKEN=your_secure_random_token' >> .env

ADMIN_DASHBOARD_TOKEN=your_secure_admin_token_here

# =============================================================================
# 📊 DATABASE CONFIGURATION
# =============================================================================
# Default: SQLite (file-based, no setup required)
DATABASE_URL=sqlite+aiosqlite:///./vocalizebot.db

# PostgreSQL example (uncomment if using PostgreSQL):
# DATABASE_URL=postgresql://username:password@localhost:5432/vocalizebot

# Echo SQL queries (set to true for debugging)
DATABASE_ECHO=false

# =============================================================================
# 🗄️ REDIS CONFIGURATION (Optional)
# =============================================================================
# For caching and session management
# Leave commented out to use in-memory caching

# REDIS_URL=redis://localhost:6379/0
# REDIS_ENABLED=false

# =============================================================================
# 🌐 SERVER CONFIGURATION
# =============================================================================

HOST=0.0.0.0
PORT=8000

# =============================================================================
# 🔒 SECURITY
# =============================================================================

# Secret key for JWT tokens and encryption
# Generate with: python3 -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=your-secret-key-change-in-production

# Allowed CORS origins (comma-separated)
# Use '*' for all origins (development only)
ALLOWED_ORIGINS=*

# =============================================================================
# 📱 WHATSAPP (Twilio) - Optional
# =============================================================================
# If you want WhatsApp integration via Twilio

# TWILIO_ACCOUNT_SID=your_twilio_account_sid
# TWILIO_AUTH_TOKEN=your_twilio_auth_token
# TWILIO_PHONE_NUMBER=+1234567890
# WHATSAPP_WEBHOOK_SECRET=your_whatsapp_webhook_secret

# =============================================================================
# 📸 INSTAGRAM - Optional
# =============================================================================
# If you want Instagram integration

# INSTAGRAM_ACCESS_TOKEN=your_instagram_access_token
# INSTAGRAM_APP_SECRET=your_instagram_app_secret
# INSTAGRAM_WEBHOOK_VERIFY_TOKEN=vocalizebot_verify_token

# =============================================================================
# 🆘 HUMAN ESCALATION
# =============================================================================
# Webhook URL for escalating issues to a human agent

# HUMAN_ESCALATION_WEBHOOK_URL=https://your-escalation-webhook.com/notify
# BLACKOUT_MODE_THRESHOLD=3
# BLACKOUT_MODE_ESCALATION_ENABLED=true

# =============================================================================
# 📈 LEAD SCORING
# =============================================================================

INITIAL_LEAD_SCORE=50
MAX_LEAD_SCORE=100
MIN_LEAD_SCORE=0

# =============================================================================
# 🚦 RATE LIMITING
# =============================================================================

RATE_LIMIT_MESSAGES_PER_MINUTE=60
RATE_LIMIT_ENABLED=true